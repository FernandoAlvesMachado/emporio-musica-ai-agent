# Copy to .env and add your own Gemini API key locally. Never commit .env.
# Shell environment variables take precedence over values in .env.
# Relative paths are resolved from EMPORIO_PROJECT_ROOT (the working directory by default).
EMPORIO_PROJECT_ROOT=.
EMPORIO_RAW_DIR=data/raw
EMPORIO_DATABASE_PATH=data/processed/emporio.sqlite3
EMPORIO_POLICIES_PATH=data/raw/políticas_da_loja.pdf

# The Google account must be eligible for the selected model and free-tier quota.
# No provider fallback or automatic model switching is performed.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
EMPORIO_CHAT_LANGUAGE=pt-BR
EMPORIO_MODEL_TIMEOUT=45
EMPORIO_MAX_TOOL_ROUNDS=6
EMPORIO_MAX_TURNS=20
